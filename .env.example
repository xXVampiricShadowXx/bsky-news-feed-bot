# --- Bluesky account -------------------------------------------------------
# Your handle, e.g. yournews.bsky.social (no @).
BLUESKY_HANDLE=
# Create an app password in Bluesky: Settings > Privacy and Security > App Passwords.
# Never put your main account password here.
BLUESKY_APP_PASSWORD=
# Optional AP World News custom-feed reposting (paused by default in the dashboard).
BLUESKY_REPOST_FEED_URI=at://did:plc:uwnijebztfbgkyeqkhp2ddmx/app.bsky.feed.generator/ap-world-news
BLUESKY_REPOST_ACCOUNT_DID=did:plc:uwnijebztfbgkyeqkhp2ddmx

# --- Dashboard -------------------------------------------------------------
# Name shown on the dashboard (optional).
BOT_NAME=News Feed Bot
APP_PORT=5000
# The dashboard only listens on this computer by default. To reach it from other
# devices, set APP_HOST=0.0.0.0 AND a DASHBOARD_PASSWORD (the bot refuses to
# listen on the network without one). Log in with any username + this password.
APP_HOST=127.0.0.1
DASHBOARD_PASSWORD=
